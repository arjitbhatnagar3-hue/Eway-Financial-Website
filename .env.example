# Copy this file to `.env` and fill in the values:   cp .env.example .env
# `.env` is git-ignored — never commit real passwords.

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Leave empty for local development → a SQLite file `eway.db` is created automatically.
# For production use PostgreSQL. Any of these URL styles work:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
#   postgres://USER:PASSWORD@HOST:5432/DBNAME            (Render / Heroku style)
#   postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/eway?sslmode=require   (Neon)
#   postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres  (Supabase)
DATABASE_URL=

# Local Postgres via docker compose (see docker-compose.yml):
# DATABASE_URL=postgresql://eway:eway@localhost:5432/eway

# ---------------------------------------------------------------------------
# FIRST ADMINISTRATOR (created on startup if the account doesn't exist yet)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# SESSION_TTL_DAYS=7
# COOKIE_SECURE=auto        # auto | true | false
# DB_ECHO=false             # log every SQL query (debugging)
