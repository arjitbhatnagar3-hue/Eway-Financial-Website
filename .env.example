# Local development defaults. Copy this file to .env before running the app.
DATABASE_URL=sqlite:///./eway.db

# Optional: set both values to create the first administrator on startup.
# Use a unique, long password and never commit a populated .env file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=EWAY Administrator

SESSION_TTL_DAYS=1
COOKIE_SECURE=auto
