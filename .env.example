# EWAY Financial Consultancy — environment configuration template.
#
# Copy this file to `.env` (same folder as main.py) and fill in real values.
# `.env` is already in .gitignore — never commit your real `.env` file.
#
# IMPORTANT: this project does NOT use any third-party API keys (no Stripe,
# no SendGrid, no AWS, no Google Maps, nothing). The only things you can
# configure are below — everything is optional, the app runs with zero
# setup using local SQLite if you skip all of this.

# ---------------------------------------------------------------------------
# DATABASE_URL — the only setting that matters for a real/production deploy.
# ---------------------------------------------------------------------------
# Local development (default if left unset — creates ./eway.db, zero setup):
# DATABASE_URL=sqlite:///./eway.db
#
# Production (PostgreSQL — Neon, Supabase, Render Postgres, AWS RDS, etc.):
# Get this exact string from your database provider's dashboard after you
# create a project/database there. It always looks like:
#   postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
# Paste it below, uncommented:
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# ---------------------------------------------------------------------------
# First administrator account — created automatically the first time the
# app starts, IF both of these are set. Use your own real email/password
# for a production deploy (do not ship with demo credentials).
# ---------------------------------------------------------------------------
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123
ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Optional tuning (safe to leave as-is / delete these lines)
# ---------------------------------------------------------------------------
# How many days a login session stays valid before needing to log in again.
SESSION_TTL_DAYS=7

# "auto" = secure cookies only when served over HTTPS (recommended).
# Force with "true" or "false" if you have a specific reason to.
COOKIE_SECURE=auto

# Set to "true" to log every SQL query to the console (debugging only).
DB_ECHO=false
